# Public site block for Unleash, imported by the base Caddyfile — only
# mounted when docker-compose.unleash.yml is in use. Same automatic Let's
# Encrypt handling as the main site.
#
# No basic auth in front of this on purpose — Unleash's own login (default
# admin/unleash4all on first visit, change it immediately) is the only gate
# on the admin UI, same call as Grafana/GlitchTip/Portainer. Unleash's
# open-source edition has no OIDC support (enterprise-only), so unlike
# Grafana/GlitchTip/Portainer this can't go behind Authelia as true SSO —
# and unlike Umami/Homepage, it can't go behind Authelia's forward_auth
# either: every visitor's browser calls this same subdomain's /api/frontend
# path directly and unauthenticated to poll live flags (see
# apps/web/src/lib/feature-flags-live.ts), so gating the whole subdomain
# would break that for every user — this still applies if this hostname is
# later put behind Cloudflare Access via docker-compose.tunnel.yml: exempt
# `/api/frontend*` from the Access policy (a separate Access Application
# with a public/bypass policy scoped to that path) before enforcing it here.
#
# Two blocks — see grafana.caddy's own comment for why: `:8080` is the
# plain-HTTP path docker-compose.tunnel.yml's Cloudflare Tunnel uses,
# dormant/unreachable for anyone on plain DNS, and the `header_up` override
# tells Unleash the original request was https even though this internal hop
# isn't — the connection Cloudflare terminated for the visitor always was.
{$UNLEASH_SITE_ADDRESS} {
	reverse_proxy unleash:4242
}

http://{$UNLEASH_SITE_ADDRESS}:8080 {
	reverse_proxy unleash:4242 {
		header_up X-Forwarded-Proto https
	}
}
