# Mounted only when docker-compose.unleash.yml is in use. See
# docker/README.md § "Access control per public subdomain" — every
# visitor's browser calls this same subdomain's /api/frontend path directly
# and unauthenticated to poll live flags (apps/web/src/lib/feature-flags-live.ts),
# so gating the whole hostname (Authelia forward_auth, or a Cloudflare
# Access policy via docker-compose.tunnel.yml) requires exempting that path
# first — a separate Access Application scoped to `/api/frontend*` with a
# public/bypass policy.
#
# Two blocks — see observability/grafana.caddy's own comment for why: `:8080`
# is the plain-HTTP path docker-compose.tunnel.yml's Cloudflare Tunnel uses,
# dormant/unreachable for anyone on plain DNS, and the `header_up` override
# tells Unleash the original request was https even though this internal hop
# isn't — the connection Cloudflare terminated for the visitor always was.
{$UNLEASH_SITE_ADDRESS} {
	reverse_proxy unleash:4242
}

http://{$UNLEASH_SITE_ADDRESS}:8080 {
	reverse_proxy unleash:4242 {
		header_up X-Forwarded-Proto https
	}
}
