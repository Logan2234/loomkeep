# Public site block for Unleash, imported by the base Caddyfile — only
# mounted when docker-compose.unleash.yml is in use. Same automatic Let's
# Encrypt handling as the main site.
#
# No basic auth in front of this on purpose — Unleash's own login (default
# admin/unleash4all on first visit, change it immediately) is the only gate,
# same call as Grafana/GlitchTip/Portainer. Unleash's open-source edition has
# no OIDC support (enterprise-only), so unlike Grafana/GlitchTip/Portainer
# this can't go behind Authelia as true SSO — it could still sit behind
# Authelia's forward_auth instead (like Homepage), since nothing here needs
# to stay reachable by anonymous visitors: the api talks to Unleash over the
# internal Docker network (UNLEASH_API_URL), never through this subdomain.
{$UNLEASH_SITE_ADDRESS} {
	reverse_proxy unleash:4242
}
