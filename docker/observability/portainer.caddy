# Public site block for Portainer, imported by the base Caddyfile — only
# mounted when docker-compose.portainer.yml is in use (it sets
# PORTAINER_SITE_ADDRESS on the caddy service and mounts this file into
# /etc/caddy/sites-enabled/). Same automatic Let's Encrypt handling as the
# main site: Caddy requests and renews its own certificate for this domain
# too, independently.
#
# Proxies to Portainer's plain-HTTP port (see docker-compose.portainer.yml's
# --http-enabled comment) — Caddy is the only TLS termination point.
#
# Two blocks — see grafana.caddy's own comment for why: `:8080` is the
# plain-HTTP path docker-compose.tunnel.yml's Cloudflare Tunnel uses,
# dormant/unreachable for anyone on plain DNS, and the `header_up` override
# tells Portainer the original request was https even though this internal
# hop isn't — the connection Cloudflare terminated for the visitor always
# was.
{$PORTAINER_SITE_ADDRESS} {
	reverse_proxy portainer:9000
}

http://{$PORTAINER_SITE_ADDRESS}:8080 {
	reverse_proxy portainer:9000 {
		header_up X-Forwarded-Proto https
	}
}
