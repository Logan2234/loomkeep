# Public site block for GlitchTip, imported by the base Caddyfile — only
# mounted when docker-compose.glitchtip.yml is in use (it sets
# GLITCHTIP_SITE_ADDRESS on the caddy service and mounts this file into
# /etc/caddy/sites-enabled/). Same automatic Let's Encrypt handling as the
# main site: Caddy requests and renews its own certificate for this domain
# too, independently.
#
# No basic auth in front of this on purpose — GlitchTip's own login (the
# first visitor creates the org/first user) is the only gate, same call as
# Grafana/Portainer.
#
# Two addresses on the same block — see grafana.caddy's own comment for why:
# `:8080` is the plain-HTTP path docker-compose.tunnel.yml's Cloudflare
# Tunnel uses, dormant/unreachable for anyone on plain DNS.
{$GLITCHTIP_SITE_ADDRESS}, {$GLITCHTIP_SITE_ADDRESS}:8080 {
	reverse_proxy glitchtip:8000
}
