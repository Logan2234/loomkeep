# Mounted only when docker-compose.homepage.yml is in use. Homepage has no
# login of its own. On the public instance it's gated by Cloudflare Access
# before the request ever reaches this hostname (see docker-compose.tunnel.yml)
# — nothing to enforce here at the Caddy layer. Self-hosters without
# Cloudflare and without that add-on are exposed on this hostname with no
# login at all — either keep it off a public hostname (bind it to a
# VPN/LAN-only address instead) or reintroduce Authelia's forward_auth in
# front of it (see docker/README.md § "Single sign-on" for the pattern —
# auth.<DOMAIN> + forward_auth against authelia:9091).
#
# Two blocks — see observability/grafana.caddy's own comment for why:
# `:8080` is the plain-HTTP path docker-compose.tunnel.yml's Cloudflare
# Tunnel uses, dormant/unreachable for anyone on plain DNS, and the
# `header_up` override tells Homepage the original request was https even
# though this internal hop isn't — the connection Cloudflare terminated for
# the visitor always was.
{$HOMEPAGE_SITE_ADDRESS} {
	reverse_proxy homepage:3000
}

http://{$HOMEPAGE_SITE_ADDRESS}:8080 {
	reverse_proxy homepage:3000 {
		header_up X-Forwarded-Proto https
	}
}
