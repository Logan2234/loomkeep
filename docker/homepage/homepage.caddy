# Mounted only when docker-compose.homepage.yml is in use. Requires
# docker-compose.authelia.yml too — see docker/README.md § "Access control
# per public subdomain".
{$HOMEPAGE_SITE_ADDRESS} {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth?authelia_url={$AUTHELIA_URL}
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}
	reverse_proxy homepage:3000
}
