# Global options for an instance proxied by Cloudflare (orange cloud), mounted
# by docker-compose.cloudflare.yml into the Caddyfile's global block.
#
# Behind Cloudflare, every request reaches Caddy from a Cloudflare server.
# Trusting Cloudflare's published ranges, and those only, lets Caddy keep the
# X-Forwarded-For chain Cloudflare sends (the visitor's address first) instead
# of replacing it with Cloudflare's own; the API then takes the visitor's
# address two hops back (TRUST_PROXY_HOPS=2). A request from anywhere else
# keeps being judged on its own address, so no one can forge theirs.
#
# Cloudflare's ranges change rarely: refresh this list from
# https://www.cloudflare.com/ips/ when they announce a change.
servers {
	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# Caddy's own access log then records the visitor too, not Cloudflare.
	client_ip_headers CF-Connecting-IP
}
