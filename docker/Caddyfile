# Single-origin reverse proxy for `web` and `api`, so CORS becomes
# same-origin.
#
# Self-host / local (default): SITE_ADDRESS unset, falls back to plain HTTP
# on :80.
#
# Public VPS (docker-compose.prod.yml): SITE_ADDRESS is set to your real
# domain, so Caddy requests and renews a Let's Encrypt certificate itself
# and serves HTTPS on :443 (with :80 -> :443 redirect). Requires ports
# 80/443 reachable from the internet and DNS already pointed at the VPS.

# `admin` binds the config/metrics API to all interfaces (not just
# 127.0.0.1) so Prometheus can reach GET /metrics — not published to the
# host, so only other containers on the compose network can reach it.
{
	admin 0.0.0.0:2019
	metrics
}

{$SITE_ADDRESS::80} {
	encode gzip zstd

	# JSON access log on stdout, picked up by Promtail the same way as
	# every other container's json-file log driver output.
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Maintenance mode: toggled by the presence of a marker file, not an env
	# var, so it flips instantly and still works if the outage is the api/db
	# themselves being down.
	#   touch ./caddy-flags/maintenance   # on
	#   rm ./caddy-flags/maintenance      # off
	root * /
	@maintenance file /flags/maintenance
	handle @maintenance {
		error "maintenance" 503
	}
	handle_errors 503 {
		root * /srv/maintenance
		rewrite * /index.html
		file_server
		header Retry-After "3600"
	}

	# NestJS mounts every route under the `api` global prefix.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3000
	}
}

# Extra site blocks, one file per service, only present when that service's
# override is actually in use. A glob over a directory that isn't mounted
# (plain self-host) matches zero files and is a no-op.
import /etc/caddy/sites-enabled/*.caddy
