# Single-origin reverse proxy used to put `web` and `api` behind one URL, so
# the browser sees a single origin and CORS becomes same-origin.
#
# Self-host / local (default): SITE_ADDRESS is left unset and falls back to
# plain HTTP on :80.
#
# Public VPS (docker-compose.prod.yml): SITE_ADDRESS is set to your real
# domain (e.g. loomkeep.app), so Caddy requests and renews a Let's Encrypt
# certificate itself and serves HTTPS on :443 (with :80 → :443 redirect).
# This requires ports 80 and 443 reachable from the internet and the
# domain's DNS already pointed at the VPS.

# Global options. `admin` binds the config/metrics API to all interfaces
# instead of the container-local default (127.0.0.1:2019) so Prometheus
# (a separate container, see docker-compose.observability.yml) can reach
# GET /metrics — it's not published to the host, so only other containers on
# the same compose network can reach it, same trust boundary as `db`. The
# admin API can reconfigure Caddy at runtime with no auth of its own; that's
# an acceptable tradeoff here since nothing untrusted shares this network.
{
	admin 0.0.0.0:2019
	metrics
}

{$SITE_ADDRESS::80} {
	# Compresses text-ish responses (html/js/css/json) before they leave the
	# server — SvelteKit and the API's JSON bodies both benefit.
	encode gzip zstd

	# Access log as JSON on stdout so Promtail picks it up the same way it
	# already picks up every other container's json-file log driver output —
	# no extra scrape config needed.
	log {
		output stdout
		format json
	}

	# Baseline security headers. HSTS is safe to send unconditionally: browsers
	# only honor it on a response actually delivered over HTTPS, which is true
	# in prod (Caddy terminates TLS itself) — over plain local HTTP it's
	# simply ignored. `includeSubDomains` is safe too since every
	# subdomain (grafana./errors.<DOMAIN>) is also served over HTTPS by Caddy.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Maintenance mode: toggled by the presence of a marker file, not an env
	# var, so it flips instantly (no reload/redeploy) and still works if the
	# outage is the api/db themselves being down. Toggle from the VPS with:
	#   touch ./caddy-flags/maintenance   # on
	#   rm ./caddy-flags/maintenance      # off
	# `root` is required for the `file` matcher below to resolve absolute
	# paths at all (unset root = it never matches); harmless for the
	# reverse_proxy handlers further down, which ignore it.
	root * /
	@maintenance file /flags/maintenance
	handle @maintenance {
		error "maintenance" 503
	}
	handle_errors 503 {
		root * /srv/maintenance
		rewrite * /index.html
		file_server
		header Retry-After "3600"
	}

	# The NestJS API mounts every route under the `api` global prefix
	# (see apps/api/src/main.ts), so forward `/api/*` untouched.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Everything else is the SvelteKit web app.
	handle {
		reverse_proxy web:3000
	}
}

# Extra site blocks, one file per service, only present when that service's
# override is actually in use — e.g. observability/grafana.caddy, mounted
# here only by docker-compose.observability.yml. A glob over a directory
# that isn't mounted (plain self-host) matches zero files and is a no-op,
# not an error — nothing to guard here.
import /etc/caddy/sites-enabled/*.caddy
