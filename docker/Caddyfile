# Single-origin reverse proxy for `web` and `api`, so CORS becomes
# same-origin.
#
# Self-host / local (default): SITE_ADDRESS unset, falls back to plain HTTP
# on :80.
#
# Public VPS (docker-compose.prod.yml): SITE_ADDRESS is set to your real
# domain, so Caddy requests and renews a Let's Encrypt certificate itself
# and serves HTTPS on :443 (with :80 -> :443 redirect). Requires ports
# 80/443 reachable from the internet and DNS already pointed at the VPS.

# The admin API stays on the container's loopback: it can rewrite this whole
# config (POST /load), so no other container on the compose network may reach
# it. `metrics` turns on per-request HTTP metrics; Prometheus scrapes them from
# the dedicated :2020 site below instead.
{
	admin localhost:2019
	metrics
}

# Metrics only, for Prometheus (docker/observability/prometheus.yml). Not
# published to the host: only containers on the compose network reach it,
# and all they get is read-only metrics.
:2020 {
	metrics
}

{$SITE_ADDRESS::80} {
	encode gzip zstd

	# JSON access log on stdout, picked up by Promtail the same way as
	# every other container's json-file log driver output.
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The camera stays allowed for the app's own origin only (ISBN and
		# profile QR scanners); no mic/geolocation/payment/USB feature is used
		# anywhere, so denying them outright means an injected or compromised
		# script can't invoke one via an embedded/child context either.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		# Isolates this app's window from cross-origin windows it opens or is
		# opened by — no popup/postMessage flow anywhere in the app relies on
		# sharing a browsing context group.
		Cross-Origin-Opener-Policy "same-origin"
		# Still Report-Only: nothing is blocked. `report-uri` is what makes it
		# worth anything — violations now reach /api/security/csp-report, which
		# logs them (deduplicated) and forwards to GlitchTip, so the real
		# breakage can be measured before switching to enforcement. The
		# 'unsafe-inline' below has to go at that point; it is why this policy
		# would be near-useless enforced as written.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://stats.loomkeep.app https://feedback.loomkeep.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://loomkeep.app https://stats.loomkeep.app https://errors.loomkeep.app https://flags.loomkeep.app https://feedback.loomkeep.app; frame-src 'self' https://feedback.loomkeep.app; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; report-uri /api/security/csp-report"
	}

	# Maintenance mode: toggled by the presence of a marker file, not an env
	# var, so it flips instantly and still works if the outage is the api/db
	# themselves being down.
	#   touch ./caddy-flags/maintenance   # on
	#   rm ./caddy-flags/maintenance      # off
	root * /
	@maintenance file /flags/maintenance
	handle @maintenance {
		error "maintenance" 503
	}
	handle_errors 503 {
		root * /srv/maintenance
		rewrite * /index.html
		file_server
		header Retry-After "3600"
	}

	# NestJS mounts every route under the `api` global prefix. EventsGateway
	# (WebSocket real-time push) is nested under it too, at /api/socket.io —
	# both to stay covered by this single block and because the access-token
	# cookie's Path=/api scope requires it — so no dedicated handle block is
	# needed for it; reverse_proxy forwards the WS upgrade transparently.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3000
	}
}

# Extra site blocks, one file per service, only present when that service's
# override is actually in use. A glob over a directory that isn't mounted
# (plain self-host) matches zero files and is a no-op.
import /etc/caddy/sites-enabled/*.caddy
