# Dependencies
node_modules/

# Builds
dist/
build/
.svelte-kit/

# Environment — never commit secrets
.env
.env.*
!.env.example

# Authelia — real config holds plaintext secrets + an RSA private key, same
# "commit the .example, never the real file" convention as .env above.
# Prefixed with docker/ (not just "authelia/"): a mid-pattern slash anchors
# a gitignore rule to the .gitignore's own directory (repo root), it does
# NOT match at every depth — these files live under docker/authelia/, so
# the unprefixed form silently never matched them.
docker/authelia/configuration.yml
docker/authelia/users_database.yml
# Stray keygen output if the RSA keypair command is ever run without
# deleting its output afterwards (see README "Single sign-on").
docker/authelia/private.pem
docker/authelia/public.pem

# Healthchecks.io read-only API key for Prometheus scraping — same
# "commit the .example, never the real file" convention as above.
docker/observability/healthchecks_token

# Generated docs (prisma-erd-generator output; regenerated on prisma generate OR modules.md for NestJS modules)
docs/*
!docs/.gitkeep

# Local dev backups
apps/api/backups/

# Logs & caches
*.log
.turbo/
coverage/

# OS / editors
.DS_Store
Thumbs.db

# Claude Code worktrees (created/removed by the harness, not repo content)
.claude/worktrees/

AGENTS.md
