# --- Database ---
POSTGRES_USER=loomkeep
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loomkeep

# --- API secrets (generate long random strings, e.g. `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Self-host: the account whose email matches this gets the "admin" entitlement
# automatically (on register and every login), unlocking the /admin panel.
# Leave empty in a multi-tenant/hosted install — there admin is granted
# per-account via User.entitlements instead.
ADMIN_EMAIL=

# --- External catalogues ---
# TMDB API Read Access Token (v4), free account: https://www.themoviedb.org/settings/api
# Without it, movie/series search fails; anime (AniList) works without any key.
TMDB_API_TOKEN=


# Optional: OMDb key for IMDb/Rotten Tomatoes/Metacritic scores (https://www.omdbapi.com/apikey.aspx).
# Empty = those ratings are omitted (TMDB/AniList scores still show).
OMDB_API_KEY=


# IGDB games catalogue via a Twitch app (https://dev.twitch.tv/console/apps).
# Empty = game search/details fail; movies/series/anime are unaffected.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# Steam Web API key (https://steamcommunity.com/dev/apikey) for the Steam import.
STEAM_API_KEY=


# Required: Google Books key (enable "Books API" in a Google Cloud project, then
# create an API key). Google Books is the only book source — empty means book
# search/import fails at runtime.
GOOGLE_BOOKS_API_KEY=


# --- Networking (defaults fit a local/NAS install) ---
# Port the API is exposed on, and the URL the browser uses to reach it.
PUBLIC_API_URL=http://localhost:3000/api


# Port the web app is exposed on, and its origin (for API CORS).
WEB_ORIGIN=http://localhost:8080


# --- Mobile access via ngrok (see README "Mobile access") ---
# Only used with the docker-compose.ngrok.yml override (Caddy reverse proxy).
# Just your ngrok static domain — the override derives PUBLIC_API_URL,
# WEB_ORIGIN and PUBLIC_NGROK from it, so you set it in one place.
NGROK_DOMAIN=your-domain.ngrok-free.app
# Host port the Caddy single-origin proxy listens on; ngrok points here.
PROXY_PORT=8088


# --- Public hosting on a VPS (see README "Public hosting (VPS)") ---
# Only used with the docker-compose.prod.yml override (Caddy reverse proxy
# with automatic Let's Encrypt HTTPS). Your real domain, DNS already pointed
# at the VPS — the override derives PUBLIC_API_URL, WEB_ORIGIN and Caddy's
# SITE_ADDRESS from it, and Caddy listens on the standard :80/:443 ports.
DOMAIN=your-domain.example

# Which docker-compose override files to combine — Compose reads this itself
# (no -f flags needed) whenever it's set in the .env of the directory you run
# `docker compose` from. The GitHub Actions deploy workflow relies on this:
# it always runs a plain `docker compose up -d --build` on the VPS, so adding
# or removing an optional add-on (observability, portainer, glitchtip, ...)
# from production is just editing this line here, not the workflow. Leave
# docker-compose.ngrok.yml OUT of this list — it's for local mobile-access
# testing, not the VPS (conflicts with docker-compose.prod.yml's Caddy setup).
# Separator is ":" on Linux/macOS (the VPS) — Compose on Windows expects ";"
# instead if you ever set this for local testing.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.observability.yml:docker-compose.portainer.yml:docker-compose.glitchtip.yml:docker-compose.authelia.yml:docker-compose.homepage.yml

# --- Single sign-on (see README, docker-compose.authelia.yml) ---
# Authelia's own secrets (session, storage, OIDC HMAC, the RSA signing key,
# your user database) live in authelia/configuration.yml and
# authelia/users_database.yml instead — gitignored real files, copied from
# their .example templates, same convention as this file. The one secret
# that DOES belong here is Grafana's OIDC client secret: Grafana reads it
# via env var (unlike GlitchTip/Portainer, which take theirs through their
# own admin UI). This must be the PLAINTEXT value — Authelia's own config
# stores only its pbkdf2-sha512 hash.
GRAFANA_OIDC_CLIENT_SECRET=


# --- Observability Palier 2 (see README, docker-compose.observability.yml) ---
# Only used when the observability override is added on top of your
# deployment. Grafana admin login — pick a real password, this dashboard is
# reachable (only from localhost/SSH tunnel by default, but still).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Observability Palier 3 (see README, docker-compose.glitchtip.yml) ---
# Only used when the glitchtip override is added on top of your deployment.
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-string
GLITCHTIP_DB_PASSWORD=change-me
# New-error/regression email alerts are OFF by default (falls back to
# consolemail://, i.e. logged to `docker compose logs glitchtip` instead of
# sent) — GlitchTip's EMAIL_URL is parsed as a plain URL, and this app's own
# Brevo SMTP_USER below contains a literal "@" that breaks that unescaped,
# so it isn't auto-derived. To enable, percent-encode your SMTP credentials
# yourself, e.g.:
# GLITCHTIP_EMAIL_URL=submission://user%40example.com:password@smtp-relay.brevo.com:587
GLITCHTIP_EMAIL_URL=
GLITCHTIP_FROM_EMAIL=glitchtip@example.com
# Django admin at /admin/ — off by default. Flip to True temporarily only
# for the one-time OIDC/SSO SocialApp setup (README "Single sign-on"), then
# set back to False. This is a plain `docker compose up -d` on the VPS (edit
# this line, redeploy, undo, redeploy again) — no git commit needed for a
# toggle you want reverted within minutes.
GLITCHTIP_ENABLE_ADMIN=False
# Both off by default (a fresh instance's very first visitor already creates
# the org/first account through the normal signup form — see the site block
# comment in docker-compose.glitchtip.yml). Flip ORGANIZATION_CREATION and/or
# USER_REGISTRATION to True temporarily only if you need a *second* account
# to self-register later (e.g. linking SSO to a fresh account instead of an
# existing one), same toggle-then-undo pattern as ENABLE_ADMIN above.
GLITCHTIP_ENABLE_ORGANIZATION_CREATION=False
GLITCHTIP_ENABLE_USER_REGISTRATION=False

# DSNs from the two GlitchTip *projects* you create on its dashboard (one for
# the API, platform "Node", one for the web app, platform "JavaScript") —
# distinct from the GLITCHTIP_* vars above, which configure the GlitchTip
# server itself. Empty = the SDK never initializes on that side, errors just
# aren't reported (see apps/api/src/instrument.ts and
# apps/web/src/hooks.client.ts). Only wired up in production (NODE_ENV) —
# local dev never reports here.
GLITCHTIP_API_DSN=
PUBLIC_GLITCHTIP_WEB_DSN=


# Outgoing email (password reset, email verification, change confirmations,
# new-episode alerts). Empty = email is silently disabled, everything else
# still works. Brevo (https://www.brevo.com) has a free SMTP relay (300/day):
# create an account, then "SMTP & API" in the sidebar for these values.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Loomkeep <noreply@loomkeep.app>"