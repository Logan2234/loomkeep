
# --- Database (required) ---

POSTGRES_USER=loomkeep
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loomkeep

# --- Auth secrets (required) ---

# Generate with e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# --- Admin (optional) ---

# Account matching this email gets the "admin" entitlement
# (unlocks /admin). Leave empty on a multi-tenant/hosted install.
ADMIN_EMAIL=

# --- Networking ---

# Required. Port the API is exposed on / URL the browser calls it at.
PUBLIC_API_URL=http://localhost:3000/api

# Optional. CORS origin(s) for the web client, comma-separated. Uncomment
# only if you change the web app's default port (8080).
# WEB_ORIGIN=http://localhost:8080

# --- Bot protection (Cloudflare Turnstile, optional) ---

# Empty = no widget on the register form, the API's own check no-ops the
# same way (no Cloudflare account configured). Create a Turnstile widget at
# https://dash.cloudflare.com > Turnstile > Add widget (Managed challenge),
# domain loomkeep.app (or your own) — gives a Site Key (public) and a
# Secret Key (private, never expose it to the browser).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Feature flags (optional) ---

# Social features (friends, comments, ratings, etc.). Default: false.
SOCIAL_ENABLED=false

# New sign-ups. Close it once your account (and any family accounts) exist.
# Default: true.
REGISTRATION_ENABLED=true

# --- Catalogue providers ---

# Required for movies/series. https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Optional, adds IMDb/Rotten Tomatoes/Metacritic scores. https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Optional, required for games (IGDB via a Twitch app). https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional, required for the Steam import. https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Required for books. Enable "Books API" in a Google Cloud project, then create a key.
GOOGLE_BOOKS_API_KEY=

# Optional. MusicBrainz usage policy asks for an identifying contact (email/URL).
MUSICBRAINZ_CONTACT=

# --- Email SMTP (optional) ---

# Empty disables email (password reset, verification, alerts).
# Brevo has a free relay (300/day): https://www.brevo.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Loomkeep <noreply@loomkeep.app>"

# --- Push notifications (Web Push, optional) ---

# Empty disables push (in-app notifications still work). Generate a pair
# with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Job monitoring (Healthchecks.io, optional) ---

# Dead-man's-switch pings, one per scheduled job (src/jobs/job-keys.ts) —
# Healthchecks.io alerts you if a job stops pinging on schedule, not just
# when it throws. Empty = pinging disabled for that job. Free account:
# https://healthchecks.io — create one check per line below, matching each
# job's own schedule (see README "Job monitoring"), then paste its ping URL.
HEALTHCHECKS_NOTIFICATIONS_SCAN_URL=
HEALTHCHECKS_MEDIA_REFRESH_STALE_URL=
HEALTHCHECKS_REPORTS_DIGEST_URL=
HEALTHCHECKS_BACKUP_URL=

# --- Public hosting on a VPS (see README "Public hosting (VPS)") ---

# Required only with the docker-compose.prod.yml override. Your real domain,
# DNS already pointed at the VPS — derives PUBLIC_API_URL, WEB_ORIGIN and
# Caddy's SITE_ADDRESS.
DOMAIN=your-domain.example

# Required only with docker-compose.prod.yml. Always run `docker compose`
# from the repo root — these paths are relative to it, not to docker/.
COMPOSE_PROJECT_NAME=loomkeep
COMPOSE_FILE=docker/docker-compose.yml:docker/docker-compose.prod.yml:docker/docker-compose.observability.yml:docker/docker-compose.portainer.yml:docker/docker-compose.glitchtip.yml:docker/docker-compose.quackback.yml:docker/docker-compose.authelia.yml:docker/docker-compose.homepage.yml

# --- Single sign-on (see README, docker-compose.authelia.yml) ---

# Required only if using the authelia override. Plaintext client secret for
# Grafana's OIDC client — Authelia's own secrets live in
# docker/authelia/*.yml instead (gitignored, copied from *.example).
GRAFANA_OIDC_CLIENT_SECRET=

# --- Landing page (see README, docker-compose.homepage.yml) ---

# Optional. API keys for Homepage's live widgets — empty just means that
# tile shows no data.

# Portainer: user icon > My account > Access tokens.
PORTAINER_API_KEY=
PORTAINER_ENV_ID=1

# GlitchTip: user icon > Settings > Auth Tokens (needs project:read).
GLITCHTIP_API_TOKEN=
GLITCHTIP_ORG_SLUG=

# Healthchecks.io: Project Settings > API Access > read-only API key.
HEALTHCHECKS_API_KEY=

# UptimeRobot: My Settings > API Keys > "Read-Only API Key" (not the
# monitor-specific or main key — read-only can't modify anything).
UPTIMEROBOT_API_KEY=

# Codecov: Settings > Access > generate token. May not even be required for
# a public repo's read-only totals (unconfirmed either way) — leave empty
# and only set this if the Codecov tile shows an auth error.
CODECOV_API_TOKEN=

# Loomkeep's own user-count widget: a shared secret between the api service
# and Homepage (not a per-service dashboard key like the others above) —
# generate any long random string yourself, e.g. `openssl rand -hex 32`.
# Empty = the endpoint stays unreachable (fails closed), not just widget-less.
HOMEPAGE_STATS_API_KEY=

# GitHub fine-grained PAT, scoped to just this repo, with "Dependabot
# alerts: read-only" AND "Code scanning alerts: read-only" permissions —
# both are gated even on a public repo (confirmed against GitHub's own
# docs), and each tile needs its own permission despite sharing one Security
# tab. Also reused on the commits/workflow-runs/PR-count/issue-count tiles
# just for the higher authenticated rate limit (5000/h vs 60/h — that data
# is public either way, being authenticated at all is what matters).
# Create at github.com > Settings > Developer settings > Personal access
# tokens > Fine-grained tokens.
HOMEPAGE_GITHUB_TOKEN=

# Brevo's REST API key (distinct from SMTP_USER/SMTP_PASS above, which are
# SMTP relay credentials) — for the email-stats tile. Brevo dashboard >
# Settings (gear icon) > SMTP & API > API Keys > Generate a new API key.
BREVO_API_KEY=

# Quackback's REST API key (feedback.loomkeep.app) — for the Feedback group's
# tiles (Planned counts, open support conversations, changelog freshness).
# Generate at /admin/settings/developers?tab=keys on the Quackback instance.
QUACKBACK_API_KEY=

# --- Observability (see README, docker-compose.observability.yml) ---

# Required only with the observability override. Grafana admin login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Error tracking (see README, docker-compose.glitchtip.yml) ---

# Required only with the glitchtip override.
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-string
GLITCHTIP_DB_PASSWORD=change-me

# Optional. SMTP URL for GlitchTip's own alert emails (own format, not
# reused from SMTP_* above). Empty = logged to `docker compose logs
# glitchtip` instead of sent.
GLITCHTIP_EMAIL_URL=
GLITCHTIP_FROM_EMAIL=glitchtip@loomkeep.app

# Optional. DSNs from the two GlitchTip projects you create on its
# dashboard (API: Node, web: JavaScript). Empty = that side never reports.
GLITCHTIP_API_DSN=
PUBLIC_GLITCHTIP_WEB_DSN=

# --- User feedback board (see README, docker-compose.quackback.yml) ---

# Required only with the quackback override. Quackback itself runs as its
# own separate deployment (docker/quackback-bootstrap.sh) with its own
# .env — this only tells Loomkeep's Caddy where to reach it.
QUACKBACK_APP_PORT=3000

# Signs the SSO token for the feedback widget's "Verified identity only"
# mode (apps/web/src/app.html + WidgetIdentify.svelte) — must be set to the
# exact same value as the secret entered in Quackback's own dashboard
# (Settings > Widget > Verified identity).
QUACKBACK_WIDGET_SECRET=

# Signing secret for Quackback's "Changelog Published" webhook
# (POST /api/webhook/changelog-published, see NewsletterModule) — must match
# the signing secret shown on that webhook's configuration screen in
# Quackback's dashboard. Empty = the webhook guard rejects every delivery.
QUACKBACK_CHANGELOG_WEBHOOK_SECRET=
