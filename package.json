{
  "name": "loomkeep",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hosted tracker for series, movies, anime — and later games, books and more.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm build:package && pnpm --parallel --filter \"./apps/*\" dev",
    "build:package": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm build:package && pnpm --filter \"./apps/*\" build",
    "test": "pnpm --filter \"./apps/*\" test",
    "lint": "pnpm --recursive --no-bail lint",
    "lint:fix": "pnpm --recursive --no-bail lint:fix",
    "spelunk": "pnpm --filter \"./apps/api\" spelunk",
    "clean": "pnpm --recursive --no-bail run clean",
    "clean:dev": "pnpm --recursive --no-bail clean:dev && rm -rf node_modules docs/*",
    "knip": "knip",
    "prepare": "husky",
    "docker:dev": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:prod": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.prod.yml up -d --build",
    "docker:full": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.prod.yml -f docker/docker-compose.observability.yml -f docker/docker-compose.portainer.yml -f docker/docker-compose.glitchtip.yml -f docker/docker-compose.authelia.yml -f docker/docker-compose.homepage.yml up -d --build"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,svelte}": "eslint --fix",
    "*.{json,md,css,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
