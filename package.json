{
  "name": "loomkeep",
  "version": "1.6.0",
  "private": true,
  "description": "Personal tracker for everything you watch, play and read — series, games and books, with more on the way — hosted or self-hosted, open-core.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm build:package && pnpm --parallel --filter \"./apps/*\" dev",
    "build:package": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm build:package && pnpm --filter \"./apps/*\" build",
    "test": "pnpm --filter \"./apps/*\" test",
    "lint": "pnpm --recursive --no-bail lint",
    "lint:fix": "pnpm --recursive --no-bail lint:fix",
    "format": "prettier --write .",
    "spelunk": "pnpm --filter \"./apps/api\" spelunk",
    "clean": "pnpm --recursive --no-bail run clean",
    "clean:dev": "pnpm --recursive --no-bail clean:dev && rm -rf node_modules docs/*",
    "knip": "knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,svelte}": "eslint --fix",
    "*.{json,md,css,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
