{
  "defaults": {
    "timeout": 30000,
    "standard": "WCAG2AA",
    "viewport": {
      "width": 1280,
      "height": 720
    },
    "runners": [
      "axe",
      "htmlcs"
    ],
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox"
      ]
    }
  },
  "urls": [
    "https://loomkeep.app/",
    "https://loomkeep.app/login",
    "https://loomkeep.app/register",
    "https://loomkeep.app/forgot-password",
    "https://loomkeep.app/reset-password",
    "https://loomkeep.app/register/check-email",
    "https://loomkeep.app/verify-email",
    "https://loomkeep.app/unsubscribe",
    "https://loomkeep.app/legal/terms-of-service",
    "https://loomkeep.app/legal/privacy-policy",
    "https://loomkeep.app/legal/legal-notice"
  ],
  "concurrency": 1,
  "useIncognitoBrowserContext": true,
  "includeNotices": true,
  "includeWarnings": true
}
