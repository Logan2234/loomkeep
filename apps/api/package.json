{
  "name": "@loomkeep/api",
  "description": "Loomkeep's NestJS REST API — auth, catalog providers and library data behind the web client",
  "version": "1.8.0",
  "author": {
    "name": "Logan WILLEM",
    "email": "loganwi322.dev@gmail.com"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "bugs": {
    "email": "loganwi322.dev@gmail.com",
    "url": "https://feedback.loomkeep.app/?board=bug-reports"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logan2234/loomkeep.git",
    "directory": "apps/api"
  },
  "scripts": {
    "build": "nest build",
    "clean": "rm -rf dist coverage coverage-e2e backups node_modules openapi.json",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/src/main",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "generate:openapi": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "test:e2e:cov": "vitest run --config ./vitest.config.e2e.mts --coverage",
    "graph": "pnpm exec ts-node -r tsconfig-paths/register scripts/graph.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@loomkeep/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.73.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "nestjs-pino": "^5.1.0",
    "nodemailer": "^10.0.0",
    "otpauth": "^9.5.2",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unleash-client": "^6.12.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fastify/static": "^10.1.3",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "prisma-erd-generator": "^3.2.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  }
}
