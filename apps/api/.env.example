# Local dev only: values that must differ from the Docker deployment.
# Everything else (provider API keys, JWT secrets, SMTP, LOG_LEVEL, ADMIN_EMAIL,
# API_CONTACT, ...) is read from the repo-root .env instead — see ConfigModule's
# envFilePath in src/app.module.ts. Copy the root .env.example too and fill in
# at least TMDB_API_TOKEN and the JWT secrets there.

NODE_ENV=development

# Local Postgres container (see docker-compose.yml for self-hosting).
DATABASE_URL="postgresql://loomkeep:loomkeep@localhost:5432/loomkeep?schema=public"

# The web dev server's own origin (Vite, not Docker's :8080) — CORS rejects
# every request otherwise. main.ts refuses to start if this is unset.
WEB_ORIGIN=http://localhost:5173
