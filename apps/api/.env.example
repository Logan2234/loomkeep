# Local dev only: values that must differ from the Docker deployment.
# Everything else (provider API keys, SMTP, ADMIN_EMAIL, MUSICBRAINZ_CONTACT,
# ...) is read from the repo-root .env instead — see ConfigModule's
# envFilePath in src/app.module.ts. Copy the root .env.example too and fill
# in at least TMDB_API_TOKEN there.

NODE_ENV=development


# CORS origin(s) for the web client — comma-separated to allow more than one
# Uncomment only if you change the default port (5173) for the web app
# WEB_ORIGIN=http://localhost:5173


# Local development (see docker-compose.yml for self-hosting).
DATABASE_URL="postgresql://loomkeep:loomkeep@localhost:5433/loomkeep?schema=public"
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"


# Where the daily automatic backup (admin "Sauvegarde") writes its .sql dumps
# (last 7 kept). Docker self-host sets this to /data/backups on a dedicated
# volume (see docker-compose.yml); empty here defaults to apps/api/backups
# for local dev (gitignored).
BACKUP_DIR=


# Structured logging (nestjs-pino, see src/common/logger.config.ts). One of
# pino's levels: fatal/error/warn/info/debug/trace/silent. Empty defaults to
# "debug" in dev (NODE_ENV=development) and "info" everywhere else. Not wired
# into any docker-compose.*.yml yet, so there's nothing to fall back to there.
LOG_LEVEL=
