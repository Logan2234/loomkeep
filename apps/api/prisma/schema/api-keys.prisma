// A personal API key for the public API (/api/v1). Only the SHA-256 of the
// secret is stored, like RefreshToken; the secret itself is shown once.
model ApiKey {
  id               String    @id @default(cuid())
  userId           String
  name             String
  tokenHash        String    @unique
  // Last characters of the secret, to tell keys apart in the settings list.
  suffix           String
  // `<resource>:read` strings (see API_KEY_SCOPES in @loomkeep/shared).
  scopes           String[]
  // Null for a key that never expires.
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  lastUsedIp       String?
  // Set once the "expires in 7 days" email went out, so it's sent only once.
  expiryNotifiedAt DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// One row per external provider per UTC day — the raw series the /admin/services
// page aggregates into "today" and "this month" depending on each provider's
// documented quota window. Never purged: a few rows per provider per day is
// negligible volume.
model ApiCallCounter {
  provider String
  // The UTC day (startOfUtcDay), a calendar day rather than an instant.
  day      DateTime @db.Date
  count    Int      @default(0)

  @@id([provider, day])
}
