enum PushPlatform {
  WEB
  ANDROID
}

// One row per browser/device push subscription. endpoint is the natural
// unique key: re-subscribing the same device updates it in place. For WEB it
// is the browser's push service URL (with its p256dh/auth keys); for ANDROID
// it is the app's FCM registration token (no keys).
model PushSubscription {
  id        String       @id @default(cuid())
  userId    String
  platform  PushPlatform @default(WEB)
  endpoint  String       @unique
  p256dh    String?
  auth      String?
  userAgent String?
  // The Android app builds this device's notifications itself, with action
  // buttons (MOB-17): it gets data-only FCM messages.
  actions   Boolean      @default(false)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Generic in-app notification. The payload is denormalised so it survives
// catalogue-cache refreshes. Kinds ("NEW_EPISODE", "FOLLOW",
// "FOLLOW_REQUEST", "FOLLOW_ACCEPTED"…) share one shape: a title, an optional
// body/link, and a `data` bag for kind-specific display extras (episode
// airDate, the social actor's username/avatar seed…). A string `type` means
// new kinds need no migration. Reading one sets `readAt`; read rows stay in
// the history for 90 days, then are purged. NEW_EPISODE rows are kept only
// as an idempotency record for the hourly scan (push/email, never shown in
// the bell) and FOLLOW_REQUEST rows are superseded by the live `Follow`
// table (the bell shows pending requests from there, with accept/reject) —
// both are excluded from the bell feed.
model Notification {
  id              String    @id @default(cuid())
  userId          String
  type            String    @default("NEW_EPISODE")
  title           String
  body            String?
  // Client-side deep link (e.g. /media/movie/42 or /u/alice).
  url             String?
  // Stable idempotency key so re-scans / re-follows don't duplicate a row:
  //   "episode:<episodeId>", "follow:<actorId>", "request:<actorId>",
  //   "accept:<actorId>". Null means "never deduped".
  dedupeKey       String?
  // Kind-specific extras. For NEW_EPISODE: { airDate }. For social kinds:
  // { actorUsername, actorDisplayName } (drives the Avatar + name in the feed).
  data            Json      @default("{}")
  createdAt       DateTime  @default(now())
  // Set once a NEW_EPISODE row has been included in a digest send on that
  // channel — the digest job's "pending content" query is simply "rows with
  // this null", so no separate date-window/timezone logic is needed to know
  // *what* to send, only *when* (see NotificationDigestService).
  emailDigestedAt DateTime?
  pushDigestedAt  DateTime?
  // Null while unread. A read row stays in the history for 90 days, and
  // keeps its dedupeKey taken meanwhile (see NotificationService.purge).
  readAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  // The daily purge of read rows uses a partial index on readAt WHERE
  // "readAt" IS NOT NULL (unread rows never purged, so never indexed),
  // written in SQL in the migration 20261124170000_indexes_and_closed_values.
  // The hourly scan's de-duplication looks keys up across every account.
  @@index([dedupeKey])
}
