// Gamification: XP ledger, level curve and reward scale.
// The level curve (xpForLevel/levelForXp, packages/shared/src/rules/level.ts,
// shared with the web) and the full barème (amount/cap/source per reason,
// apps/api/src/gamification/xp-rules.ts) are pure data, kept out of Prisma.

// One credited unit of XP. A reversal stamps `revokedAt` rather than deleting
// the row, so the history can show what was taken back; every sum reads live
// rows only. Re-crediting the same source starts from a fresh row, so cycling
// a source (mark watched, unwatch, rewatch) never manufactures XP. Admin
// adjustments are the exception: distinct signed rows, never revoked.
//
// Idempotence is a partial unique index on (userId, reason, sourceType,
// sourceId) WHERE "revokedAt" IS NULL, written in the migration's SQL:
// Prisma's @@unique cannot express the WHERE, and a full one would block
// re-crediting a source once revoked.
model XpEntry {
  id         String    @id @default(cuid())
  userId     String
  // Mirror of packages/shared/src/enums.ts XpReason. String, not a Prisma
  // enum, so a new reason needs no migration (same rationale as
  // ActivityEvent.type).
  reason     String
  // Table the gain is anchored to ("EpisodeWatch", "MediaEntry", "DOMAIN"…
  // — see XpRule.sourceType in xp-rules.ts) and that row's id. Together with
  // reason they make crediting idempotent (the partial unique index above) and
  // let the nightly reconciliation job re-verify each entry still has a live
  // source. Non-nullable: Postgres treats NULLs as distinct in a unique
  // index, so a nullable sourceId would let the same (userId, reason) pair
  // be credited unboundedly instead of being caught by the constraint — a
  // gain with no real anchor uses a synthetic source instead (sourceType:
  // "DOMAIN", sourceId: the domain name) rather than going nullable.
  sourceType String
  sourceId   String
  // Denormalised from XpRule.amount at grant time, so the ledger stays
  // readable (and reconciliation-stable) after a future barème change —
  // re-tuning an amount must never retroactively rewrite history.
  amount     Int
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  // Display snapshot of what earned it, taken at grant time like
  // ActivityEvent's: the source row is usually gone by the time a revoked
  // line is read back (an unwatch deletes its EpisodeWatch). Null title for a
  // reason with no work behind it (profile, admin adjustment…).
  title      String?
  href       String?
  // Reason-specific extras: { seasonNumber, episodeNumber }, { achievementKey },
  // { domain }.
  data       Json      @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
  @@index([reason, id])
  // XpService.revokeBySource: one user's live rows of a few sources, on
  // every unwatch, deletion or vote change. The partial unique index has
  // `reason` between `userId` and the source, so it can't serve this.
  @@index([userId, sourceType, sourceId])
}

// Materialised sum of the user's XpEntry rows, kept only for cheap
// leaderboard ordering — never written by hand, always recomputed
// from XpEntry via aggregate(_sum) (see XpService.recomputeScore). Same
// "derived per-user projection in its own table" shape as UserEntitlement.
// No peakXp: level is derived from current XP in both directions, so revoking
// XP lowers the level too.
model UserScore {
  userId    String   @id
  xp        Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([xp])
}

// One row per unlocked achievement. Definitions live in code
// (apps/api/src/gamification/achievements/registry.ts), never in the
// database — a self-host install must never need seeding. Achievements are
// never revoked once unlocked, unlike XpEntry: a trophy isn't taken back
// because you later removed the title that earned it.
model UserAchievement {
  id          String    @id @default(cuid())
  userId      String
  // Stable key matching a registry entry — string, not a Prisma enum, so a
  // new achievement needs no migration (same rationale as XpEntry.reason).
  // Each tier of a tiered achievement is its own key (e.g.
  // "cinephile_bronze"/"cinephile_silver"/"cinephile_gold"), not a shared
  // row with a tier column.
  key         String
  unlockedAt  DateTime  @default(now())
  // Null until the unlock bubble has shown this achievement to the
  // user once — set by PATCH /achievements/:id/displayed. Independent of
  // unlockedAt: an unlock can happen server-side (a live action, or the
  // nightly sweep) while the user isn't even in the app.
  displayedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model AchievementRarity {
  key           String   @id
  holders       Int
  eligibleUsers Int
  computedAt    DateTime @default(now())
}
