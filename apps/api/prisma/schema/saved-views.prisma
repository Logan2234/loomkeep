// A library page's filters and order under a name (UX-05), applied from a chip
// above that library's filters. `filters` is `SavedViewFiltersDto`, checked
// by the API: it only ever holds what that domain's list understands.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  domain    Domain
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
