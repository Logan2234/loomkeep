generator client {
  provider = "prisma-client-js"
}

// Dev-only: renders an entity-relationship diagram of the schema as a Mermaid
// markdown file (viewable in GitHub/VS Code). Skipped in the Docker build via
// DISABLE_ERD so it never runs in prod. The .md target avoids the headless
// Chromium that the SVG/PNG targets require.
generator erd {
  provider = "prisma-erd-generator"
  output   = "../../../docs/erd.md"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  MOVIE
  SERIES
  ANIME
}

// Top-level content domain a user can compose their app from. MEDIA groups
// MOVIE/SERIES/ANIME; BOOKS/GAMES/MUSIC each have their own screens (search,
// library, stats). `User.enabledDomains` drives the nav (see web isDomainEnabled).
// PODCASTS/BOARDGAMES are planned P3 placeholders — no backing tables yet,
// surfaced as "coming soon" and kept out of the enabledDomains default (opt-in).
enum Domain {
  MEDIA
  BOOKS
  GAMES
  MUSIC
  PODCASTS
  BOARDGAMES
}

// How often a channel (email/push) delivers the "new episode" digest. See
// packages/shared/src/enums.ts DigestCadence for the gating rationale.
enum DigestCadence {
  DISABLED
  WEEKLY
  DAILY
}

// Operational permission level, orthogonal to UserEntitlement (the paid-tier
// seam, see docs/adr/0001-open-core-agpl.md). See packages/shared/src/enums.ts
// Role for the rationale.
enum Role {
  USER
  ADMIN
}

// --- Open-core (docs/adr/0001-open-core-agpl.md) ---

enum Plan {
  FREE
  PREMIUM
}

// How a user came to have their current plan — informational, for support/admin
// visibility (e.g. "why is this account premium") rather than a behavioral
// switch. STRIPE accounts are the only ones with a backing Subscription row;
// the others are granted directly, with no billing behind them.
enum EntitlementSource {
  STRIPE
  SELF_HOST_LICENSE
  FRIENDS_FAMILY
  BETA_TESTER
  COMPENSATION
  // Set by hand from the admin user panel — the catch-all for a manual grant
  // that isn't specifically one of the reasons above.
  ADMIN_GRANT
}

// One row per user, upserted. `plan` is a derived projection of the user's
// Subscription rows for STRIPE-sourced entitlements (see
// EntitlementService.recompute) — never write it directly for a user with an
// active subscription, or the two will drift. For SELF_HOST_LICENSE/
// FRIENDS_FAMILY/BETA_TESTER/COMPENSATION there is no Subscription at all;
// `plan` is set directly by whoever grants it.
model UserEntitlement {
  userId    String             @id
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @default(FREE)
  source    EntitlementSource?
  grantedAt DateTime?
  expiresAt DateTime?
  // Per-feature/quota exceptions that override what `plan` would otherwise
  // grant — both a grandfathered feature (kept despite plan) and a negotiated
  // quota (different from the plan default) are the same shape: a feature key
  // mapped to its override value. See docs/adr/0001-open-core-agpl.md.
  overrides Json               @default("{}")
  updatedAt DateTime           @updatedAt
}

enum SubscriptionProvider {
  STRIPE
}

// Mirrors Stripe's own subscription status values rather than inventing an
// active/inactive binary — PAST_DUE (failed payment, still in its grace
// period) and TRIALING carry real product decisions that a plain boolean
// would lose.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

// One row per provider subscription, updated in place as Stripe webhooks
// arrive — not append-only like EpisodeWatch, since a subscription is a
// single stateful object, not a stream of discrete events. A user can have at
// most one ACTIVE row: enforced by a partial unique index added by hand in
// the migration (Prisma has no declarative partial-unique syntax) — see
// migration.sql for "one_active_subscription_per_user".
model Subscription {
  id                     String               @id @default(cuid())
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               SubscriptionProvider
  providerSubscriptionId String               @unique
  status                 SubscriptionStatus
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean              @default(false)
  canceledAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([userId])
}

// --- Social (P4) — all gated behind the runtime SOCIAL_ENABLED flag. ---
// Mirror of packages/shared/src/enums.ts; see there for the full rationale.

// How reachable a profile is (the authN layer). Caps the per-facet audience.
enum ProfileAccess {
  PUBLIC
  PRIVATE
  GHOST // "Figurant": invisible but can participate anonymously.
}

// Who may see a passive-content facet (the authZ layer). NONE < FRIENDS < PUBLIC.
enum VisibilityAudience {
  PUBLIC
  FRIENDS
  NONE
}

// Passive-content facets tuned per domain. Coarse on purpose (splittable later).
enum VisibilityFacet {
  LIBRARY // presence + status + progress + favorites
  ACTIVITY // appearance in the activity feed
}

// State of a directed follow. A follow of a PUBLIC profile is created ACCEPTED
// immediately; a follow of a PRIVATE profile starts PENDING until approved.
enum FollowStatus {
  PENDING
  ACCEPTED
}

// What a review targets. Works (MEDIA/GAME/BOOK/MUSIC) plus finer media levels.
enum ReviewTargetType {
  MEDIA
  SEASON
  EPISODE
  GAME
  BOOK
  MUSIC
}

// A review's audience (no PRIVATE — a review is at least FRIENDS). Only felt
// when social is enabled.
enum ReviewVisibility {
  FRIENDS
  PUBLIC
}

// What a comment thread targets. Same shape as ReviewTargetType (a comment
// under a work, or one of its seasons/episodes).
enum CommentTargetType {
  MEDIA
  SEASON
  EPISODE
  GAME
  BOOK
  MUSIC
}

// Fixed reaction set for comments (backlog: a full emoji picker). Display
// glyphs live in shared code (COMMENT_EMOTE_DISPLAY) — this enum stores the
// identifier, not the glyph.
enum CommentEmote {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  DISLIKE
}

// A vote cast on someone else's review — Reddit-style, one active vote per
// (user, review), never shown attributed to a voter (only the aggregate score
// + the viewer's own vote are ever surfaced).
enum ReviewVoteValue {
  UP
  DOWN
}

// What a report targets. COMMENT is the only kind produced today; REVIEW/USER
// are modelled now so a future "report a review/profile" needs no migration.
enum ReportTargetType {
  COMMENT
  REVIEW
  USER
  LIST
}

// Top-level reason bucket for a report, chosen before a precise ReportMotif
// (except OTHER, which skips straight to the free-text `reason` instead).
// Deliberately generic across every ReportTargetType — not comment-specific —
// so filing a report against a review/user/list later needs no enum change.
enum ReportCategory {
  SPAM
  ILLEGAL_CONTENT
  HARASSMENT
  HATE_SPEECH
  SEXUAL_CONTENT
  VIOLENCE
  MINOR_ENDANGERMENT
  SPOILER
  IMPERSONATION
  MISINFORMATION
  STOLEN_CONTENT
  MISLEADING_REVIEW
  OTHER
}

// Precise reason within a ReportCategory. The category->motif mapping is
// enforced in ReportService.create, not here — Prisma has no cross-column
// check constraint for this. OTHER has no motif (null): the free-text
// `reason` carries the detail instead.
enum ReportMotif {
  SPAM_PROMOTIONAL
  SPAM_SUSPICIOUS_LINK
  SPAM_REPEATED
  ILLEGAL_PIRACY_LINK
  HARASSMENT_INSULTS
  HARASSMENT_THREATS
  HARASSMENT_STALKING
  HARASSMENT_DOXXING
  HATE_RACISM
  HATE_SEXISM_LGBTQ
  HATE_OTHER
  SEXUAL_EXPLICIT
  VIOLENCE_GRAPHIC
  MINOR_ENDANGERMENT_CONTENT
  MINOR_ENDANGERMENT_SOLICITATION
  SPOILER_UNTAGGED
  IMPERSONATION_REAL_PERSON
  IMPERSONATION_FAKE_ACCOUNT
  MISINFORMATION_FALSE_FACT
  STOLEN_CONTENT_PLAGIARIZED
  MISLEADING_REVIEW_MANIPULATION
}

// A list's kind: RANKED shows explicit rank order (drag-to-reorder, "top 10"),
// COLLECTION is an unordered grid. Same storage (ListItem + position) either way.
enum ListKind {
  RANKED
  COLLECTION
}

// A list's own explicit audience (mirrors Review's own-scope pattern, not the
// per-domain VisibilitySetting facets — a list isn't tied to one domain).
// Unlike ReviewVisibility, PRIVATE exists: a list defaults to it.
enum ListVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// The two restrictive measures actually implemented (see ModerationDecision) —
// keep in lockstep with the CGU §9 sanctions list: the CGU must describe
// exactly what the code can do, not more (DSA art. 14).
enum ModerationMeasure {
  COMMENT_REMOVED
  ACCOUNT_DELETED
}

// DSA art. 17(3)(d): whether the measure is grounded in the content's alleged
// illegality (point a) or in a breach of the CGU (point b, tosClause names
// the clause).
enum ModerationLegalBasis {
  ILLEGAL_CONTENT
  TOS_BREACH
}

// Sources we actually fetch from (canonical).
enum CatalogSource {
  TMDB
  ANILIST
}

// All sources an external ID can come from. TVDB/IMDB are secondary
// identifiers kept for reconciliation (e.g. TV Time import) and deduplication.
enum ExternalSource {
  TMDB
  ANILIST
  TVDB
  IMDB
}

enum EntryStatus {
  WATCHING
  COMPLETED
  PLANNED
  DROPPED
  // Series/anime: everything released is watched but the show is still airing.
  // Never stored — it is a derived, read-time status (see LibraryService).
  UP_TO_DATE
}

// How the user holds a movie/series/anime, if at all. NONE (default) means
// unset — most entries never get this filled in. DIGITAL/STREAMING carry a
// free-form `ownershipSource` (e.g. "Netflix", "Apple TV"); PHYSICAL/BORROWED
// don't need one.
enum MediaOwnershipStatus {
  NONE
  PHYSICAL
  DIGITAL
  STREAMING
  BORROWED
}

// Source a game's catalogue data comes from. IGDB is the only one today.
enum GameSource {
  IGDB
}

// A game's library status. Unlike EntryStatus it is entirely user-set: games
// have no per-episode progress to derive "playing"/"completed" from.
enum GameStatus {
  BACKLOG
  PLAYING
  COMPLETED
  DROPPED
}

// How the user holds a game, if at all. NONE (default) means unset. DIGITAL
// carries a free-form `ownershipSource` (e.g. "Steam"), SUBSCRIPTION too (e.g.
// "Xbox Game Pass"); PHYSICAL/BORROWED don't need one.
enum GameOwnershipStatus {
  NONE
  PHYSICAL
  DIGITAL
  SUBSCRIPTION
  BORROWED
}

// Source a book's catalogue data comes from. Open Library only — keyless and
// unmetered, unlike the Google Books API it replaced.
enum BookSource {
  OPEN_LIBRARY
}

// A book's library status. Like GameStatus it is entirely user-set; page
// progress is tracked separately on the entry. TO_READ doubles as the wishlist.
enum BookStatus {
  TO_READ
  READING
  READ
  DROPPED
}

// How the user holds a book, if at all. NONE (default) means unset. DIGITAL
// carries a free-form `ownershipSource` (e.g. "Kindle"), AUDIO too (e.g.
// "Audible"); PHYSICAL/BORROWED don't need one.
enum BookOwnershipStatus {
  NONE
  PHYSICAL
  DIGITAL
  AUDIO
  BORROWED
}

// Source a music item's catalogue data comes from. MusicBrainz only.
enum MusicSource {
  MUSICBRAINZ
}

// An album's library status. Deliberately binary, unlike GameStatus/
// BookStatus: an album listen is a short, single-session event, so there is
// no "in progress" or "dropped" state. TO_LISTEN doubles as the wishlist.
enum MusicStatus {
  TO_LISTEN
  LISTENED
}

// How the user holds an album, if at all. NONE (default) means unset.
// DIGITAL/STREAMING carry a free-form `ownershipSource` (e.g. "Bandcamp",
// "Spotify"); PHYSICAL/BORROWED don't need one.
enum MusicOwnershipStatus {
  NONE
  PHYSICAL
  DIGITAL
  STREAMING
  BORROWED
}

model User {
  id                         String           @id @default(cuid())
  email                      String           @unique
  passwordHash               String
  // Free-form label shown around the app; not unique. See `username` for the
  // unique, login-capable handle.
  displayName                String
  // Unique login handle (alongside email). Assigned at registration, editable
  // in Sécurité.
  username                   String           @unique
  birthDate                  DateTime?
  // Opt-in to 18+ titles; only effective when birthDate proves the account is 18+.
  allowAdultContent          Boolean          @default(false)
  // Communication preferences: cadence at which each channel delivers the
  // "new episode" digest. See DigestCadence.
  notifyEmail                DigestCadence    @default(WEEKLY)
  notifyPush                 DigestCadence    @default(WEEKLY)
  // IANA timezone (e.g. "Europe/Paris"), used to time the digest at a local
  // hour. Auto-detected client-side at onboarding, editable afterwards.
  timezone                   String           @default("Europe/Paris")
  // Opt-in to the release newsletter (sent automatically when a changelog
  // entry is published on Quackback — see NewsletterService) — separate
  // from notifyEmail, which is scoped to "new episode" alerts, not marketing.
  notifyNewsletter           Boolean          @default(false)
  // Proof-of-consent timestamp (GDPR art. 7(1)): set the moment
  // notifyNewsletter flips false → true, left untouched afterwards — including
  // across a later opt-out — so it always records when consent was last given.
  newsletterOptInAt          DateTime?
  // Stable per-user unsubscribe link target, lazily generated on first
  // newsletter send and reused in every subsequent one — not a
  // single-use/expiring UserToken, since minting one per recipient per send
  // would grow the token table without bound as the newsletter goes out
  // repeatedly. Low-stakes if it ever leaked (only lets someone toggle this
  // one preference off), so it's a plain unguessable string, not hashed.
  newsletterUnsubscribeToken String?          @unique
  // Set once the verification email's link has been opened. Informational only
  // in self-host (no feature is gated on it) — see UserToken.
  emailVerified              Boolean          @default(false)
  // Free-form public bio shown on the social profile (P4). Null until set.
  bio                        String?
  // Profile picture, stored in-row (not on disk) so it rides along with
  // pg_dump backups like everything else. avatarMimeType/avatarUpdatedAt are
  // null together with avatar; avatarUpdatedAt also cache-busts the public
  // GET /users/:id/avatar URL.
  avatar                     Bytes?
  avatarMimeType             String?
  avatarUpdatedAt            DateTime?
  // Social (P4): how reachable this profile is. Default PRIVATE — the safe
  // default (nothing exposed to the public without an accepted follow). The
  // per-domain/facet audiences live in VisibilitySetting.
  profileAccess              ProfileAccess    @default(PRIVATE)
  // Default audience applied to a new review unless overridden at publication.
  defaultReviewVisibility    ReviewVisibility @default(FRIENDS)
  // Default audience applied to a new list unless overridden at creation.
  defaultListVisibility      ListVisibility   @default(PRIVATE)
  // Operational permission level (gates /admin). Separate axis from the paid
  // tier (see UserEntitlement below): an admin isn't "the highest tier".
  role                       Role             @default(USER)
  // Composition seam: content domains the user enabled. Drives the nav today;
  // search/notif filtering follow at P3. Empty by default — the onboarding
  // wizard's domain step is what actually turns these on for a new account.
  enabledDomains             Domain[]         @default([])
  // Ordered ids of the mobile bottom-bar shortcuts (see web navigation.ts,
  // `MobileNavId`). Free-form strings, not a Prisma enum: the set is a web-UI
  // concern (includes the "menu" launcher and non-domain routes), gated at
  // render time. Default mirrors DEFAULT_BOTTOM_SHORTCUTS.
  mobileNavShortcuts         String[]         @default(["home", "search", "menu", "calendar", "account"])
  // UI language (Paraglide locale code, "fr" or "en"). Set from the
  // Accept-Language header at registration (see AuthService.register), and
  // editable from Réglages > Apparence — this is also the sync-across-devices
  // seam.
  locale                     String           @default("fr")
  // Opaque secret for the public .ics calendar subscription URL (not hashed:
  // looked up directly by calendar apps, which can't send an Authorization
  // header). Null until first requested from Réglages > Export.
  calendarToken              String?          @unique
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  // Set once the mandatory first-run onboarding wizard is completed (see
  // POST /users/me/complete-onboarding). Null gates app/+layout.svelte into
  // showing the wizard instead of the app chrome — including for accounts
  // that existed before this field shipped.
  onboardedAt                DateTime?
  // Proof-of-consent for the CGU (LK-C03): the LEGAL_VERSION in effect when
  // the user last accepted, and when. Null for accounts predating this field
  // (backfilled by migration to the version in effect at that time — see
  // 20260820000000_add_accepted_terms). app/+layout.svelte blocks with a
  // re-acceptance prompt when acceptedTermsVersion no longer matches the
  // current LEGAL_VERSION.
  acceptedTermsAt            DateTime?
  acceptedTermsVersion       String?
  // LK-C21: when the user self-certified being at least 15 (register.dto.ts
  // requires it). Null for accounts predating this field.
  certifiedAgeAt             DateTime?
  // LK-C06: last time this account did anything that proves a human is still
  // behind it — bumped on register, login and refresh-token rotation (not
  // just login, since a long-lived session never re-enters credentials).
  // Drives both the admin "last active" column and the inactive-account job
  // below. Null only for accounts predating this field (backfilled by
  // migration from the best signal then available).
  lastActiveAt               DateTime?
  // Set when the inactivity reminder email is sent (see
  // InactiveAccountService); cleared back to null the moment lastActiveAt is
  // next bumped, so a returning user gets the full inactivity window again
  // instead of being deleted on the strength of a stale warning.
  inactivityWarningSentAt    DateTime?

  entries                    LibraryEntry[]
  episodeWatches             EpisodeWatch[]
  refreshTokens              RefreshToken[]
  devices                    UserDevice[]
  notifications              Notification[]
  pushSubscriptions          PushSubscription[]
  gameEntries                GameEntry[]
  bookEntries                BookEntry[]
  readingGoals               ReadingGoal[]
  musicEntries               MusicEntry[]
  tokens                     UserToken[]
  emailChangeRequests        EmailChangeRequest[]
  securityEvents             SecurityEvent[]
  importRuns                 ImportRun[]
  visibilitySettings         VisibilitySetting[]
  following                  Follow[]             @relation("UserFollowing")
  followers                  Follow[]             @relation("UserFollowers")
  blocking                   Block[]              @relation("UserBlocking")
  blockedBy                  Block[]              @relation("UserBlockedBy")
  reviews                    Review[]
  reviewVotes                ReviewVote[]
  activityEvents             ActivityEvent[]
  comments                   Comment[]
  commentReactions           CommentReaction[]
  reportsFiled               Report[]             @relation("ReportsFiled")
  reportsResolved            Report[]             @relation("ReportsResolved")
  lists                      List[]
  listMemberships            ListMember[]
  moderationDecisionsAgainst ModerationDecision[] @relation("ModerationDecisionSubject")
  moderationDecisionsMade    ModerationDecision[] @relation("ModerationDecisionAdmin")
  entitlement                UserEntitlement?
  subscriptions              Subscription[]

  @@index([lastActiveAt])
}

// Social (P4): per-user, per-domain, per-facet audience. One row overrides the
// coded default (FRIENDS) for a (domain, facet) pair; absence = default. Only
// the two passive-content facets are stored here — reviews carry their own
// scope and comments are public by nature. Effective visibility is still capped
// by User.profileAccess at read time.
model VisibilitySetting {
  id       String             @id @default(cuid())
  userId   String
  domain   Domain
  facet    VisibilityFacet
  audience VisibilityAudience
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain, facet])
}

// Social (P4): directed follow edge. `followerId` follows `followeeId`.
// Friendship (the "Amis" audience) is a reciprocal pair of ACCEPTED follows.
// On a PRIVATE followee the edge is PENDING until the followee approves it;
// an accepted follow of a PRIVATE profile grants friend-level visibility
// (Instagram-style approval), while on a PUBLIC profile friend-level requires
// the follow to be mutual. See VisibilityService.
model Follow {
  id         String       @id @default(cuid())
  followerId String
  followeeId String
  status     FollowStatus
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  follower   User         @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User         @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, status])
}

// Social (P4): a hard block. Removes any follow edges between the two, prevents
// re-following and content access, and neutralizes comments/mentions from the
// blocked user. Directed: `blockerId` blocked `blockedId`.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Social (P4): the single source of truth for a user's /10 rating on a target
// (a work, or a media season/episode). Rating is mandatory, text optional.
// Editing your own review always works (even with social off — it's your
// rating); reading others' and the FRIENDS/PUBLIC audience are social-gated.
// One review per (user, target); edits are historised in ReviewRevision.
// targetId is not a FK (polymorphic across item/season/episode tables).
model Review {
  id         String           @id @default(cuid())
  // Nullable: account deletion detaches the author (SetNull) instead of
  // deleting the review — other users' votes/replies stay meaningful, the
  // front renders a "Utilisateur supprimé" placeholder.
  userId     String?
  targetType ReviewTargetType
  targetId   String
  rating     Float
  text       String?
  visibility ReviewVisibility @default(FRIENDS)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  revisions  ReviewRevision[]
  votes      ReviewVote[]

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// One active vote per (user, review) — a second vote on the same review
// replaces the first (upsert on the unique pair), same pattern as
// CommentReaction. Voting on your own review isn't allowed (checked in
// ReviewService), so there's no self-vote case to model here.
model ReviewVote {
  id        String          @id @default(cuid())
  reviewId  String
  userId    String
  value     ReviewVoteValue
  createdAt DateTime        @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

// One immutable snapshot per review edit (V1, V2, …), newest by createdAt.
model ReviewRevision {
  id        String   @id @default(cuid())
  reviewId  String
  rating    Float
  text      String?
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
}

// Social (P4): a comment/reply on an item (work, season or episode —
// CommentTargetType mirrors ReviewTargetType). Flat + one reply level: a
// reply's parentId always points at a top-level comment (never chained), the
// UI enforces this by only offering "reply" on top-level comments. Deletion is
// soft (text cleared, deletedAt set) so replies stay attached and readable —
// hard-deleting a parent would orphan or lose the whole sub-thread.
model Comment {
  id             String            @id @default(cuid())
  targetType     CommentTargetType
  targetId       String
  // Nullable: account deletion detaches the author (SetNull) rather than
  // cascading, for the same reason as the soft-delete above — a hard delete
  // would orphan replies other users posted under this comment.
  authorId       String?
  parentId       String?
  text           String?
  // Author-set manual spoiler tag. Combined at read time with the auto
  // progression-based gate (see CommentService) into a per-viewer "masked"
  // hint — the raw tag itself is what the edit form prefills.
  spoilerTag     Boolean           @default(false)
  edited         Boolean           @default(false)
  deletedAt      DateTime?
  // Set only by admin takedown (adminRemove) — distinguishes the tombstone
  // shown to readers ("supprimé par un administrateur" vs the author's own
  // "supprimé").
  deletedByAdmin Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([targetType, targetId, createdAt])
  @@index([parentId])
}

// One active reaction per (user, comment) — posting a new emote replaces it
// (upsert on the unique pair), not a multi-emote-per-user model.
model CommentReaction {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  emote     CommentEmote
  createdAt DateTime     @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

// Social (P4): a user-submitted report against a polymorphic target — a
// comment today, extensible to reviews/profiles later without a new table
// (targetType/targetId, same pattern as Review/ActivityEvent). Feeds the admin
// moderation queue (/admin/reports). targetId is not a FK (polymorphic).
model Report {
  id           String           @id @default(cuid())
  targetType   ReportTargetType
  targetId     String
  // Nullable: account deletion detaches the reporter (SetNull) — same
  // pattern as resolvedById below — so the moderation record survives.
  reporterId   String?
  // Nullable: reports filed before the category/motif picker existed have
  // neither. New submissions always set category (motif too, except OTHER).
  category     ReportCategory?
  motif        ReportMotif?
  reason       String?
  status       ReportStatus     @default(PENDING)
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter            User?                @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy          User?                @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  moderationDecisions ModerationDecision[]

  @@index([status, createdAt])
  @@index([category])
}

// DSA art. 17 "statement of reasons" record — one row per restrictive measure
// actually applied (not per report: DISMISSED/no-op reports never create one,
// and admin account deletions can happen with no report at all, see
// admin-users.controller.ts deleteUser). Deliberately its own table rather
// than extra columns on Report: it has its own lifecycle (a legal notice,
// never revised) and must survive the subject's account being deleted, which
// Report's reporterId/resolvedById pattern already establishes (SetNull).
// subjectEmail/subjectUsername are snapshotted (not read through the relation)
// because ACCOUNT_DELETED rows outlive the user row itself.
model ModerationDecision {
  id         String            @id @default(cuid())
  measure    ModerationMeasure
  targetType ReportTargetType
  // Comment id for COMMENT_REMOVED; equals subjectUserId for ACCOUNT_DELETED.
  targetId   String

  subjectUserId   String?
  subjectEmail    String
  subjectUsername String

  legalBasis      ModerationLegalBasis
  // Prefilled from the originating report's category/motif when there is
  // one, editable by the admin before the notice is sent.
  reasonCategory  ReportCategory?
  reasonMotif     ReportMotif?
  reasonText      String
  // Free-text CGU clause reference shown in the notice (e.g. "§7 — Règles de
  // conduite"), or the legal ground when legalBasis is ILLEGAL_CONTENT.
  tosClause       String
  // COMMENT_REMOVED only: the comment's text before the tombstone nulled it,
  // kept for evidence — admin-only, never re-exposed publicly.
  contentSnapshot String?

  // Always false: moderation here is human-only. Column exists so the notice
  // (and any future audit) states it explicitly, per DSA art. 17(3)(c).
  automated Boolean @default(false)

  decidedById String?
  decidedAt   DateTime @default(now())
  reportId    String?

  subject   User?   @relation("ModerationDecisionSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  decidedBy User?   @relation("ModerationDecisionAdmin", fields: [decidedById], references: [id], onDelete: SetNull)
  report    Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([subjectUserId])
  @@index([decidedAt])
}

// Social (P4): a cross-domain, user-curated list of works (RANKED "top 10" or
// an unordered COLLECTION). Own explicit visibility, like Review — never
// inherited from the per-domain VisibilitySetting facets. Managing your own
// lists works even with social off (mirrors Review's own-CRUD-ungated split);
// only reading someone else's shared list is social-gated. Editors
// (ListMember) can mutate title/description/items but not delete the list,
// change visibility, or manage members — those stay owner-only. Editors
// bypass `visibility` for reads (membership itself is the grant).
model List {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  kind        ListKind
  visibility  ListVisibility @default(PRIVATE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   ListItem[]
  members ListMember[]

  @@index([userId])
}

// Social (P4): grants a user edit access to another user's list (add/remove/
// reorder items, edit title/description) — added directly by the owner via
// username, no invite/accept step. Mirrors Follow/Block's directed
// join-table shape, but for write access rather than visibility.
model ListMember {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
}

// One work in a list, work-level only (no season/episode — narrower than
// ReviewTargetType/CommentTargetType, whose enum is reused as-is; SEASON/
// EPISODE values are rejected at the DTO layer). `position` is a dense
// 0..n-1 index rewritten wholesale on reorder. Concurrent editors are
// possible now (ListMember): reorder/update take an optimistic lock on
// List.updatedAt (see ListService) rather than real-time sync.
model ListItem {
  id         String           @id @default(cuid())
  listId     String
  targetType ReviewTargetType
  targetId   String
  position   Int
  addedAt    DateTime         @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, targetType, targetId])
  @@index([listId, position])
}

// One row per browser/device push subscription (Web Push). endpoint is the
// natural unique key: re-subscribing the same device updates its keys in place.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// In-app notifications. Payload is denormalised so a notification survives
// catalogue-cache refreshes. Generic in-app notification. Kinds ("NEW_EPISODE",
// "FOLLOW", "FOLLOW_REQUEST", "FOLLOW_ACCEPTED"…) share one shape: a title, an
// optional body/link, and a `data` bag for kind-specific display extras
// (episode airDate, the social actor's username/avatar seed…). A string `type`
// means new kinds need no migration. There's no "read" state: reading a
// notification (the notification bell) deletes its row, so a row's mere
// existence means unread. NEW_EPISODE rows are kept around only as an
// idempotency record for the hourly scan (push/email, never shown in the
// bell) and FOLLOW_REQUEST rows are superseded by the live `Follow` table
// (the bell shows pending requests from there, with accept/reject) — both
// are excluded from the bell feed.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("NEW_EPISODE")
  title     String
  body      String?
  // Client-side deep link (e.g. /media/movie/42 or /u/alice).
  url       String?
  // Stable idempotency key so re-scans / re-follows don't duplicate a row:
  //   "episode:<episodeId>", "follow:<actorId>", "request:<actorId>",
  //   "accept:<actorId>". Null means "never deduped".
  dedupeKey String?
  // Kind-specific extras. For NEW_EPISODE: { airDate }. For social kinds:
  // { actorUsername, actorDisplayName } (drives the Avatar + name in the feed).
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  // Set once a NEW_EPISODE row has been included in a digest send on that
  // channel — the digest job's "pending content" query is simply "rows with
  // this null", so no separate date-window/timezone logic is needed to know
  // *what* to send, only *when* (see NotificationDigestService).
  emailDigestedAt DateTime?
  pushDigestedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

// Social (P4): materialised activity feed. Append-only log of a user's actions
// (started/finished/rated a work…). Two surfaces read from it: the home feed
// (followed users, `homeFeed = true` milestones only) and a user's profile
// timeline (everything, gated by their Activité visibility). The target work is
// denormalised (title/imageUrl/href) so a feed page needn't fan out across the
// four domain tables on every read. `data` carries kind-specific extras
// (rating, episode code, aggregation count).
model ActivityEvent {
  id         String   @id @default(cuid())
  // The actor.
  userId     String
  // ActivityType: ADDED, STARTED, FINISHED, DROPPED, REWATCHED, PROGRESS,
  // FAVORITED, REVIEWED. A string so new kinds need no migration.
  type       String
  // Domain enum value (MEDIA/GAMES/BOOKS/MUSIC) — used to gate the profile
  // timeline against the actor's Activité audience for that domain.
  domain     String
  // Polymorphic work: ReviewTargetType-style ("MEDIA"/"GAME"/"BOOK"/"MUSIC")
  // + the internal item id.
  targetType String
  targetId   String
  // WORK / SEASON / EPISODE — the granularity, per the feed matrix.
  level      String   @default("WORK")
  // Whether this event surfaces on followers' home feed (matrix milestone).
  homeFeed   Boolean  @default(false)
  // Denormalised display snapshot of the target at emit time.
  title      String
  imageUrl   String?
  href       String?
  // Kind-specific extras: { rating } for REVIEWED, { seasonNumber, episodeNumber }
  // for PROGRESS, etc.
  data       Json     @default("{}")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Home feed: recent events of followed users, filtered on homeFeed.
  @@index([userId, createdAt])
  @@index([homeFeed, createdAt])
}

// One row per execution of a scheduled/admin-triggered job (notification scan,
// media refresh…), for the admin "Jobs & tâches" page. Pruned to the last 50
// rows per jobKey at write time (see JobRunService) so the table stays bounded
// on a self-host instance running for years.
model JobRun {
  id         String   @id @default(cuid())
  // Stable identifier, e.g. "notifications.scan", "media.refreshStale".
  jobKey     String
  startedAt  DateTime
  finishedAt DateTime
  status     String
  // Short human summary of the outcome, e.g. "12 notification(s) créée(s)".
  summary    String?
  // Present only when status is "FAILURE".
  error      String?

  @@index([jobKey, startedAt])
}

// One row per device/session, so refreshing on the phone does not log out the desktop.
// The row survives token rotation (only tokenHash/jti/lastUsedAt change), so it
// models a durable "connected device" — see auth.service refresh().
model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  // Refresh-JWT id (payload `jti`); lets the current device be flagged in the
  // sessions list without transmitting the token itself.
  jti        String   @unique
  // Raw User-Agent captured at sign-in, to label the device in the UI.
  userAgent  String?
  expiresAt  DateTime
  // Bumped on every rotation — the session's "last active" timestamp.
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Durable record of every device a user has ever logged in from, independent
// of RefreshToken (which is pruned on logout/revoke/expiry/password-reset and
// would otherwise misreport a familiar browser as "new" on the next login).
// deviceKey is the normalized browser+OS label (see shared deviceLabel()),
// not the raw User-Agent — a browser version bump shouldn't read as a new
// device. Seeded (without an alert) on register, upserted on every login;
// AuthService.login() emails+logs a SecurityEvent only when the row is created.
model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceKey   String
  userAgent   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceKey])
  @@index([userId])
}

enum UserTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// One-time links mailed to the user (password reset, email verification):
// same shape (a hashed token + an expiry), so both share a row via `type`. A
// fresh request invalidates the previous one of the same type (see
// AuthService.requestPasswordReset / .register). The raw token is only ever
// mailed as a link (MailService) — its hash is what's stored here.
model UserToken {
  id        String        @id @default(cuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum SecurityEventType {
  USER_REGISTERED
  USER_DELETED
  EMAIL_CHANGED
  PASSWORD_CHANGED
  PASSWORD_RESET
  LOGIN_FAILED
  NEW_DEVICE_LOGIN
}

// One sensitive account action, for the admin "Sécurité" page. userId is
// nullable + onDelete: SetNull (not Cascade) so the trail survives account
// deletion — USER_DELETED itself would otherwise vanish the instant it's
// written. `identifier` is only ever written for LOGIN_FAILED (the string
// actually typed at a login attempt, independent of any account — see
// SecurityEventService#record); every other type derives its display email
// from userId → User.email at read time, so it anonymises itself the moment
// the account is deleted instead of surviving indefinitely.
model SecurityEvent {
  id         String            @id @default(cuid())
  type       SecurityEventType
  userId     String?
  identifier String?
  detail     String?
  userAgent  String?
  createdAt  DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
}

// One committed import (tvtime/storygraph/goodreads/steam), for the admin
// "Imports" audit log. Analyze-only runs write nothing and aren't logged.
// userId is nullable + onDelete: SetNull; the display email is always
// derived from userId → User.email at read time (no denormalised
// identifier — unlike SecurityEvent, ImportRun has no account-less write
// path to justify one), so it reads as null once the account is deleted.
model ImportRun {
  id         String   @id @default(cuid())
  userId     String?
  sourceId   String
  // Nullable: rows written before this column existed have no domain, and
  // are deliberately left out of the free-import-per-domain check rather
  // than backfilled — see ImportJobService#getQuota.
  domain     Domain?
  status     String
  // Items actually written (the user's kept selection), regardless of outcome.
  itemCount  Int
  overwrite  Boolean  @default(false)
  // Human summary joined from the report's tiles; null on failure.
  summary    String?
  // Present only when status is "FAILURE".
  error      String?
  startedAt  DateTime
  finishedAt DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sourceId, startedAt])
  @@index([userId])
}

// One row per persisted backup dump on disk (BACKUP_DIR), for the admin
// "Sauvegarde" page's list/download/delete UI. Pruned to the 7 most recent at
// write time (see BackupService) — both the row and its file are deleted
// together, the row is never orphaned from its file or vice versa.
model BackupFile {
  id        String   @id @default(cuid())
  filename  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Audit log of newsletter emails sent to notifyNewsletter accounts. Release
// notes themselves live on Quackback (feedback.loomkeep.app/changelog) —
// this table only records that a given Quackback changelog entry triggered
// a send, so a retried webhook delivery is a no-op (unique on
// quackbackChangelogId, reserved before the emails go out — see
// NewsletterService).
model NewsletterSend {
  id                   String   @id @default(cuid())
  quackbackChangelogId String   @unique
  title                String
  recipientCount       Int      @default(0)
  sentAt               DateTime @default(now())

  @@index([sentAt])
}

// One row per external provider per UTC day — the raw series the /admin/services
// page aggregates into "today" and "this month" depending on each provider's
// documented quota window. Unbounded (like SecurityEvent/ImportRun): a few
// rows per provider per day is negligible volume.
model ApiCallCounter {
  id       String   @id @default(cuid())
  provider String
  day      DateTime
  count    Int      @default(0)

  @@unique([provider, day])
  @@index([provider])
}

// One pending email change per row; a fresh request invalidates the previous
// one (see UsersController.changeEmail). The new address only replaces
// User.email once its code is confirmed (UsersController.confirmEmailChange).
model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  codeHash  String   @unique
  // Failed confirm attempts; the request is deleted after 5 (see
  // MAX_EMAIL_CHANGE_ATTEMPTS) to bound brute-forcing the 6-digit code.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// On-demand cache: a media exists here only once at least one user references it.
// Search results are served live from TMDB/AniList and never persisted.
model MediaItem {
  id              String        @id @default(cuid())
  type            MediaType
  canonicalSource CatalogSource
  title           String
  posterUrl       String?
  backdropUrl     String?
  overview        String?
  releaseDate     DateTime?
  // Airing status as reported by the source (free-form: "Returning Series", "FINISHED"…).
  status          String?
  genres          String[]
  // Average minutes per episode (series/anime) or the film's runtime; null until
  // captured from the source. Used by the stats aggregation for watch time.
  runtimeMin      Int?
  // 18+ title (TMDB `adult` movies, AniList hentai). Restricted per-account.
  isAdult         Boolean       @default(false)
  metadata        Json          @default("{}")
  lastSyncedAt    DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  externalIds MediaExternalId[]
  seasons     Season[]
  entries     LibraryEntry[]
}

model MediaExternalId {
  id          String         @id @default(cuid())
  mediaItemId String
  source      ExternalSource
  externalId  String
  // The owning MediaItem's type, denormalised here so the unique constraint
  // below can disambiguate it. TMDB numbers movies and TV series in separate
  // ID spaces, so the same externalId can legitimately refer to two different
  // titles depending on type — without `type` in the key, upserting a TMDB
  // series would silently overwrite an unrelated TMDB movie that happens to
  // share the same numeric id (or vice versa).
  type        MediaType

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([source, externalId, type])
  @@index([mediaItemId])
}

model Season {
  id          String  @id @default(cuid())
  mediaItemId String
  number      Int
  title       String?

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  episodes  Episode[]

  @@unique([mediaItemId, number])
}

model Episode {
  id       String    @id @default(cuid())
  seasonId String
  number   Int
  title    String?
  airDate  DateTime?

  season  Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watches EpisodeWatch[]

  @@unique([seasonId, number])
}

model LibraryEntry {
  id              String               @id @default(cuid())
  userId          String
  mediaItemId     String
  status          EntryStatus          @default(PLANNED)
  notes           String?
  favorite        Boolean              @default(false)
  startedAt       DateTime?
  finishedAt      DateTime?
  ownershipStatus MediaOwnershipStatus @default(NONE)
  // Free-form detail for DIGITAL/STREAMING (e.g. "Netflix"); null otherwise.
  ownershipSource String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem MediaItem     @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  replays   MovieReplay[]

  @@unique([userId, mediaItemId])
}

// One row per completed replay, beyond the entry's own first completion —
// same shape as GameReplay/BookReplay. Movies only: series/anime rewatches
// are tracked per-episode via EpisodeWatch instead.
model MovieReplay {
  id             String   @id @default(cuid())
  libraryEntryId String
  finishedAt     DateTime @default(now())

  libraryEntry LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)

  @@index([libraryEntryId])
}

// One row per viewing: watching the same episode twice = two rows (rewatch).
model EpisodeWatch {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  watchedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId, episodeId])
}

// On-demand cache for games, mirroring MediaItem: a game exists here only once
// at least one user references it. Games have no seasons/episodes, so there is
// no progress model — the library entry's status is user-set.
model GameItem {
  id              String     @id @default(cuid())
  canonicalSource GameSource
  title           String
  coverUrl        String?
  backdropUrl     String?
  overview        String?
  releaseDate     DateTime?
  genres          String[]
  platforms       String[]
  // 18+ title (IGDB "Erotic" theme). Restricted per-account, like MediaItem.
  isAdult         Boolean    @default(false)
  metadata        Json       @default("{}")
  lastSyncedAt    DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  externalIds GameExternalId[]
  entries     GameEntry[]
}

model GameExternalId {
  id         String     @id @default(cuid())
  gameItemId String
  source     GameSource
  externalId String

  gameItem GameItem @relation(fields: [gameItemId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([gameItemId])
}

model GameEntry {
  id              String              @id @default(cuid())
  userId          String
  gameItemId      String
  status          GameStatus          @default(BACKLOG)
  notes           String?
  favorite        Boolean             @default(false)
  // Total time played, in minutes. Imported from Steam (playtime_forever);
  // manually editable. No session history yet — this is the running total.
  playtimeMinutes Int                 @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  ownershipStatus GameOwnershipStatus @default(NONE)
  // Free-form detail for DIGITAL/SUBSCRIPTION (e.g. "Steam"); null otherwise.
  ownershipSource String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameItem GameItem     @relation(fields: [gameItemId], references: [id], onDelete: Cascade)
  replays  GameReplay[]

  @@unique([userId, gameItemId])
}

// One row per completed replay, beyond the entry's own first completion —
// mirrors EpisodeWatch's minimalism (a single "when" per viewing/completion).
model GameReplay {
  id          String   @id @default(cuid())
  gameEntryId String
  finishedAt  DateTime @default(now())

  gameEntry GameEntry @relation(fields: [gameEntryId], references: [id], onDelete: Cascade)

  @@index([gameEntryId])
}

// On-demand cache for books, mirroring GameItem: a book exists here only once
// at least one user references it. Books have no chapter model — the library
// entry's status is user-set and page progress lives on the entry.
model BookItem {
  id              String     @id @default(cuid())
  canonicalSource BookSource
  title           String
  authors         String[]
  coverUrl        String?
  overview        String?
  releaseDate     DateTime?
  genres          String[]
  // Number of pages, when the source knows it.
  pageCount       Int?
  // 18+ title, restricted per-account like MediaItem/GameItem. Open Library
  // exposes no maturity rating, so this stays false for now — kept so the
  // per-account restriction still has a hook the day a source provides one.
  isAdult         Boolean    @default(false)
  metadata        Json       @default("{}")
  lastSyncedAt    DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  externalIds BookExternalId[]
  entries     BookEntry[]
}

model BookExternalId {
  id         String     @id @default(cuid())
  bookItemId String
  source     BookSource
  externalId String

  bookItem BookItem @relation(fields: [bookItemId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([bookItemId])
}

model BookEntry {
  id              String              @id @default(cuid())
  userId          String
  bookItemId      String
  status          BookStatus          @default(TO_READ)
  notes           String?
  favorite        Boolean             @default(false)
  // Current reading position, in pages. No session history — running position.
  currentPage     Int                 @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  ownershipStatus BookOwnershipStatus @default(NONE)
  // Free-form detail for DIGITAL/AUDIO (e.g. "Kindle"); null otherwise.
  ownershipSource String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookItem BookItem     @relation(fields: [bookItemId], references: [id], onDelete: Cascade)
  replays  BookReplay[]

  @@unique([userId, bookItemId])
}

// One row per completed reread, beyond the entry's own first completion —
// mirrors EpisodeWatch's minimalism (a single "when" per viewing/completion).
model BookReplay {
  id          String   @id @default(cuid())
  bookEntryId String
  finishedAt  DateTime @default(now())

  bookEntry BookEntry @relation(fields: [bookEntryId], references: [id], onDelete: Cascade)

  @@index([bookEntryId])
}

// A user's yearly reading target (e.g. "30 books in 2026"). Progress towards
// it is computed on read, not stored — see BookLibraryService.getReadingGoal.
model ReadingGoal {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  target    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

// On-demand cache for albums, mirroring BookItem: an album exists here only
// once at least one user references it. Albums have no page/chapter model —
// the library entry's status is user-set (binary: to-listen/listened).
model MusicItem {
  id              String      @id @default(cuid())
  canonicalSource MusicSource
  title           String
  artists         String[]
  coverUrl        String?
  releaseDate     DateTime?
  genres          String[]
  // Release-group primary type (Album/EP/Single/Compilation…), informational.
  albumType       String?
  // Number of tracks, when the source knows it.
  trackCount      Int?
  // Sum of known track durations, in minutes — null until enough tracks carry
  // a duration (see MusicBrainzProvider's totalDurationMs).
  durationMin     Int?
  metadata        Json        @default("{}")
  lastSyncedAt    DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  externalIds MusicExternalId[]
  entries     MusicEntry[]
}

model MusicExternalId {
  id          String      @id @default(cuid())
  musicItemId String
  source      MusicSource
  externalId  String

  musicItem MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([musicItemId])
}

model MusicEntry {
  id              String               @id @default(cuid())
  userId          String
  musicItemId     String
  status          MusicStatus          @default(TO_LISTEN)
  notes           String?
  favorite        Boolean              @default(false)
  startedAt       DateTime?
  finishedAt      DateTime?
  ownershipStatus MusicOwnershipStatus @default(NONE)
  // Free-form detail for DIGITAL/STREAMING (e.g. "Spotify"); null otherwise.
  ownershipSource String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  musicItem MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)

  @@unique([userId, musicItemId])
}
