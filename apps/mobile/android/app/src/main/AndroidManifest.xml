<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Share" from another app (MOB-18): MainActivity hands the text to /app/share. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- App Links (MOB-08): verified against https://loomkeep.app/.well-known/assetlinks.json.
                 The app pages, plus the account pages emails link to. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="loomkeep.app" />
                <data android:path="/app" />
                <data android:pathPrefix="/app/" />
                <data android:pathPrefix="/verify-email" />
                <data android:pathPrefix="/reset-password" />
                <data android:pathPrefix="/forgot-password" />
                <data android:pathPrefix="/login" />
                <data android:pathPrefix="/register" />
                <data android:pathPrefix="/account/" />
                <data android:pathPrefix="/unsubscribe" />
            </intent-filter>

        </activity>

        <!-- Home-screen widgets (MOB-20). -->
        <receiver
            android:name=".widgets.ToWatchWidgetReceiver"
            android:label="@string/widget_to_watch_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_to_watch" />
        </receiver>
        <receiver
            android:name=".widgets.ReleasesWidgetReceiver"
            android:label="@string/widget_releases_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_releases" />
        </receiver>
        <receiver
            android:name=".widgets.ChronoWidgetReceiver"
            android:label="@string/widget_chrono_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chrono" />
        </receiver>
        <receiver
            android:name=".widgets.StreakWidgetReceiver"
            android:label="@string/widget_streak_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak" />
        </receiver>
        <receiver
            android:name=".widgets.SearchWidgetReceiver"
            android:label="@string/widget_search_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_search" />
        </receiver>
        <activity
            android:name=".widgets.WidgetStyleActivity"
            android:theme="@style/WidgetStyleTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Pushes Android draws itself (app in the background) get Loomkeep's mark. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- FCM goes to ShellMessagingService instead of the push plugin's own
             service, to draw data-only pushes with buttons (MOB-17). Its class
             is only built with Firebase's config, like the plugin. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".ShellMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- Play installs Google's barcode scanner module with the app (MOB-07);
             a sideloaded APK downloads it on its first scan instead. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
