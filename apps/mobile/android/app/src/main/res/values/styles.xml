<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/seance_accent</item>
        <item name="colorPrimaryDark">@color/splash_background</item>
        <item name="colorAccent">@color/seance_accent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- The date picker and select lists the WebView opens read these. -->
        <item name="colorPrimary">@color/seance_accent</item>
        <item name="colorPrimaryDark">@color/splash_background</item>
        <item name="colorAccent">@color/seance_accent</item>
        <item name="colorControlActivated">@color/seance_accent</item>
        <item name="android:colorAccent">@color/seance_accent</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:datePickerDialogTheme">@style/ShellPickerDialog</item>
        <item name="android:timePickerDialogTheme">@style/ShellPickerDialog</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- The theme chosen in Loomkeep, whatever the system's (Android 13+). -->
    <style name="AppTheme.NoActionBarLaunch.Dark">
        <item name="windowSplashScreenBackground">@color/seance_dark</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Light">
        <item name="windowSplashScreenBackground">@color/seance_paper</item>
    </style>

    <style name="ShellPickerDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/seance_accent</item>
        <item name="android:colorAccent">@color/seance_accent</item>
    </style>

    <!-- WidgetStyleActivity: only its dialog shows, over the home screen. -->
    <style name="WidgetStyleTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>