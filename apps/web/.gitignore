# Typed API client, derived from the OpenAPI document — see root .gitignore
# for the reasoning; listed here too so eslint.config.mjs's local
# includeIgnoreFile() picks it up (the root .gitignore's copy doesn't:
# ESLint resolves a config's `ignores` relative to that config file's own
# directory, not repo root, so a root-relative pattern read from there
# never matches from inside apps/web/eslint.config.mjs).
src/lib/api/generated/schema.d.ts
