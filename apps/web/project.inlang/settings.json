{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": ["fr", "en", "it"],
  "modules": [
    "./project.inlang/plugins/plugin-message-format@4.4.0.js",
    "./project.inlang/plugins/plugin-m-function-matcher@2.2.6.js"
  ],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}/common.json",
      "./messages/{locale}/errors.json",
      "./messages/{locale}/admin.json",
      "./messages/{locale}/other.json",
      "./messages/{locale}/works.json",
      "./messages/{locale}/library.json",
      "./messages/{locale}/social.json",
      "./messages/{locale}/home.json",
      "./messages/{locale}/auth.json",
      "./messages/{locale}/gamification.json",
      "./messages/{locale}/settings.json",
      "./messages/{locale}/site.json"
    ]
  }
}
