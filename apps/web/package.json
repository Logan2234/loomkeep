{
  "name": "@loomkeep/web",
  "private": true,
  "version": "1.6.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "clean": "rm -rf build",
    "clean:dev": "rm -rf build node_modules .svelte-kit",
    "dev": "vite dev",
    "build": "vite build",
    "generate:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@loomkeep/shared": "workspace:*",
    "@sentry/sveltekit": "^10.69.0",
    "@tanstack/svelte-query": "^6.1.38",
    "mermaid": "^11.16.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "svelte-dnd-action": "^0.9.78"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/sveltekit": "^1.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "workbox-precaching": "^7.4.1"
  }
}
