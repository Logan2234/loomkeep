{
  "name": "@loomkeep/web",
  "private": true,
  "version": "1.6.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "clean": "rm -rf build",
    "clean:dev": "rm -rf build node_modules .svelte-kit",
    "dev": "vite dev",
    "build": "vite build",
    "generate:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"a11y_accesskey:error,a11y_aria_activedescendant_has_tabindex:error,a11y_aria_attributes:error,a11y_autocomplete_valid:error,a11y_autofocus:error,a11y_click_events_have_key_events:error,a11y_consider_explicit_label:error,a11y_distracting_elements:error,a11y_figcaption_index:error,a11y_figcaption_parent:error,a11y_hidden:error,a11y_img_redundant_alt:error,a11y_incorrect_aria_attribute_type:error,a11y_incorrect_aria_attribute_type_boolean:error,a11y_incorrect_aria_attribute_type_id:error,a11y_incorrect_aria_attribute_type_idlist:error,a11y_incorrect_aria_attribute_type_integer:error,a11y_incorrect_aria_attribute_type_token:error,a11y_incorrect_aria_attribute_type_tokenlist:error,a11y_incorrect_aria_attribute_type_tristate:error,a11y_interactive_supports_focus:error,a11y_invalid_attribute:error,a11y_label_has_associated_control:error,a11y_media_has_caption:error,a11y_misplaced_role:error,a11y_misplaced_scope:error,a11y_missing_attribute:error,a11y_missing_content:error,a11y_mouse_events_have_key_events:error,a11y_no_abstract_role:error,a11y_no_interactive_element_to_noninteractive_role:error,a11y_no_noninteractive_element_interactions:error,a11y_no_noninteractive_element_to_interactive_role:error,a11y_no_noninteractive_tabindex:error,a11y_no_redundant_roles:error,a11y_no_static_element_interactions:error,a11y_positive_tabindex:error,a11y_role_has_required_aria_props:error,a11y_role_supports_aria_props:error,a11y_role_supports_aria_props_implicit:error,a11y_unknown_aria_attribute:error,a11y_unknown_role:error\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@loomkeep/shared": "workspace:*",
    "@sentry/sveltekit": "^10.69.0",
    "@tanstack/svelte-query": "^6.1.38",
    "mermaid": "^11.16.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "svelte-dnd-action": "^0.9.78",
    "unleash-proxy-client": "^3.8.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/sveltekit": "^1.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "workbox-precaching": "^7.4.1"
  }
}
