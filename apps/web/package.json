{
  "name": "@loomkeep/web",
  "description": "Loomkeep's SvelteKit web client — the frontend consuming @loomkeep/api",
  "version": "1.8.0",
  "author": {
    "name": "Logan WILLEM",
    "email": "loganwi322.dev@gmail.com"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "bugs": {
    "email": "loganwi322.dev@gmail.com",
    "url": "https://feedback.loomkeep.app/?board=bug-reports"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logan2234/loomkeep.git",
    "directory": "apps/web"
  },
  "scripts": {
    "clean": "rm -rf build node_modules .svelte-kit coverage",
    "dev": "vite dev",
    "build": "vite build",
    "generate:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
    "generate:api-types": "openapi-typescript ../api/openapi.json -o src/lib/api/generated/schema.d.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@loomkeep/shared": "workspace:*",
    "@sentry/sveltekit": "^10.73.0",
    "@tanstack/svelte-query": "^6.1.48",
    "mermaid": "^11.17.2",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "svelte-dnd-action": "^0.9.79",
    "unleash-proxy-client": "^3.8.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "workbox-precaching": "^7.4.1"
  }
}
