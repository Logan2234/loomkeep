{
  "name": "@loomkeep/shared",
  "description": "Types, enums and DTOs shared between the Loomkeep API and web app",
  "version": "1.15.0",
  "author": {
    "name": "Logan WILLEM",
    "email": "loganwi322.dev@gmail.com"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "bugs": {
    "email": "loganwi322.dev@gmail.com",
    "url": "https://feedback.loomkeep.app/?board=bug-reports"
  },
  "sideEffects": false,
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logan2234/loomkeep.git",
    "directory": "packages/shared"
  },
  "exports": {
    "./contracts": {
      "source": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./rules": {
      "source": "./src/rules/index.ts",
      "types": "./dist/rules/index.d.ts",
      "default": "./dist/rules/index.js"
    },
    "./catalog": {
      "source": "./src/catalog/index.ts",
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./enums": {
      "source": "./src/enums.ts",
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist node_modules",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "vitest": "^5.1.1"
  }
}
